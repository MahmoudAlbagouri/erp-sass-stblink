<html lang='ar' dir='rtl'>
  <head>
    <meta charset='UTF-8' />
    <title>فاتورة ضريبية - {{invoiceNumber}}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Cairo', sans-serif;
        color: #333;
        font-size: 13px;
        line-height: 1.6;
        background: #fff;
        padding: 20px;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #d32f2f;
        padding-bottom: 15px;
        margin-bottom: 25px;
      }
      .company-info h1 {
        color: #d32f2f;
        font-size: 22px;
        margin-bottom: 5px;
      }
      .company-info p {
        color: #666;
        font-size: 12px;
        margin: 2px 0;
      }
      .logo {
        max-height: 70px;
        width: auto;
      }

      .doc-title {
        text-align: center;
        margin-bottom: 25px;
      }
      .doc-title h2 {
        color: #d32f2f;
        font-size: 24px;
        margin-bottom: 5px;
      }
      .doc-title p {
        color: #777;
        font-size: 12px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 25px;
      }
      .box {
        background: #fafafa;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #eee;
      }
      .box-title {
        color: #d32f2f;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 10px;
        padding-bottom: 5px;
        border-bottom: 1px solid #ddd;
      }
      .box p {
        margin: 4px 0;
        font-size: 12px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
        font-size: 12px;
      }
      th {
        background-color: #d32f2f;
        color: #fff;
        padding: 10px 12px;
        text-align: right;
        font-weight: 700;
      }
      td {
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
        text-align: right;
      }
      tr:nth-child(even) td {
        background-color: #fafafa;
      }

      .totals-section {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 25px;
      }
      .totals-box {
        width: 320px;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
      }
      .total-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 15px;
        border-bottom: 1px solid #eee;
        font-size: 13px;
      }
      .final-total {
        background: #d32f2f;
        color: #fff;
        font-weight: 700;
        font-size: 15px;
      }

      .trust-footer {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #fafafa;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #eee;
        margin-top: 30px;
      }
      .trust-logo {
        height: 50px;
        width: auto;
      }
      .trust-info {
        font-size: 11px;
        line-height: 1.4;
      }

      @media print {
        body {
          padding: 0;
        }
        th,
        .final-total,
        .trust-footer {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>
  <body>
    <div class='header'>
      <div class='company-info'>
        <h1>Smart Tech Business</h1>
        <p>التقنية الذكية للأعمال</p>
        <p>جدة حي الروضة</p>
        <p>السجل التجاري: 7053885393</p>
      </div>
      <img src='{{logo}}' class='logo' alt='STB Logo' />
    </div>

    <div class='doc-title'>
      <h2>فاتورة ضريبية / TAX INVOICE</h2>
      <p>رقم الفاتورة:
        <strong>{{invoiceNumber}}</strong>
        &nbsp;|&nbsp; تاريخ الإصدار:
        {{date}}</p>
      <p>مرجع عرض السعر: <strong>{{quotationNumber}}</strong></p>
    </div>

    <div class='info-grid'>
      <div class='box'>
        <div class='box-title'>👤 بيانات العميل</div>
        <p><strong>الاسم:</strong> {{customerName}}</p>
        <p><strong>الجوال:</strong> {{customerPhone}}</p>
        <p><strong>العنوان:</strong> {{customerAddress}}</p>
      </div>
      <div class='box'>
        <div class='box-title'>🏦 الحسابات البنكية</div>
        {{#each bankAccounts}}
          <p><strong>{{this.bankName}}:</strong></p>
          <p
            style='direction: ltr; text-align: right; font-family: monospace;'
          >{{this.iban}}</p>
        {{/each}}
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th style='width: 5%;'>#</th>
          <th style='width: 40%;'>المنتج / الخدمة</th>
          <th style='width: 10%;'>الكمية</th>
          <th style='width: 15%;'>سعر الوحدة</th>
          <th style='width: 15%;'>الإجمالي</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
          <tr>
            <td>{{@index}}</td>
            <td>{{this.description}}</td>
            <td>{{this.qty}}</td>
            <td>{{this.unitPrice}}</td>
            <td>{{this.total}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class='totals-section'>
      <div class='totals-box'>
        <div class='total-row'><span>الإجمالي قبل الضريبة:</span>
          <span>{{subTotal}} ريال</span></div>
        <div class='total-row'><span>ضريبة القيمة المضافة (15%):</span>
          <span>{{taxAmount}} ريال</span></div>
        <div class='total-row final-total'><span>الإجمالي النهائي:</span>
          <span>{{grandTotal}} ريال</span></div>
      </div>
    </div>

    <div class='trust-footer'>
      <img
        src='{{companyImage}}'
        class='trust-logo'
        alt='Saudi Business Center'
      />
      <div class='trust-info'>
        <strong>المركز السعودي للأعمال</strong><br />
        Saudi Business Center<br />
        سجل تجاري: 7053885393<br />
        رقم معروف: 37240
      </div>
    </div>
  </body>
</html>