{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^puppeteer$": "<rootDir>/utils/puppeteer.stub.ts"
  }
}
